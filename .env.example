# --- VAULT CONFIG --- #
VAULT_ADDR=http://vault:8200

# --- Shared Database Config --- #
POSTGRES_USER=moviesearch_user
POSTGRES_DB=moviesearch_db
DATABASE_HOST=postgres

# --- NestJS Config --- #
AI_SERVICE_URL=http://backend-python:8000
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d
THROTTLE_TTL_MS=60000
THROTTLE_LIMIT=100

FRONTEND_URL=https://localhost
ALLOWED_ORIGINS=https://localhost

# -- Google Oauth --- #
GOOGLE_CLIENT_ID=google_client_id
GOOGLE_CALLBACK_URL=https://localhost/api/auth/google/callback

# -- Github Oauth --- #
GITHUB_CLIENT_ID=github_client_id
GITHUB_CALLBACK_URL=https://localhost/api/auth/github/callback

# --- Python Config --- #
MODEL_NAME=all-MiniLM-L6-v2 

# --- Frontend config --- #
VITE_API_URL=https://localhost/api

# --- MONGODB --- #
MONGO_DB_NAME=chatDB
MONGO_ROOT_USERNAME=movieAdmin

# --- SMTP Config --- #
SMTP_HOST=smtp.somemailserver.com
SMTP_PORT=465
SMTP_USER=no-reply@somemailserver.com


# --- Grafana Admin --- #
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=change-me-before-deploy
