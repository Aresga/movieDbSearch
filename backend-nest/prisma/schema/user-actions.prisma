enum MovieAction {
  watched
  wishlisted
}

model UserMovieAction {
  id        BigInt      @id @default(autoincrement())
  userId    String
  movieId   Int
  action    MovieAction
  createdAt DateTime    @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([movieId])
  @@index([userId, action])
  @@map("user_movie_actions")
}
