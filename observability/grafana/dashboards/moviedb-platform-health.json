      "targets": [
        {
          "expr": "rate(prometheus_rule_evaluation_duration_seconds_sum{rule_group=~\"moviedb_.*\"}[5m]) / rate(prometheus_rule_evaluation_duration_seconds_count{rule_group=~\"moviedb_.*\"}[5m])",
