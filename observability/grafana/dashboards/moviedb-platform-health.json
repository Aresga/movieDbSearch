      "targets": [
        {
          "expr": "rate(process_cpu_seconds_total{job=\"backend-nest\"}[5m])",
          "legendFormat": "CPU cores used",
          "refId": "A"
        }
      ],
      "title": "Nest — CPU usage (rate of process_cpu_seconds)",
      "type": "timeseries"
    },
    {
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": {
        "defaults": {
