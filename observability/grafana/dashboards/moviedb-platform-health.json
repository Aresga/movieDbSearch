          "refId": "A"
        }
      ],
      "title": "MovieDB rule group evaluation time",
      "type": "timeseries"
    },
    {
      "type": "row",
      "title": "Nest (Node.js) — saturation & memory",
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 22 },
      "id": 11,
      "collapsed": false
    },
    {
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "palette-classic" },
