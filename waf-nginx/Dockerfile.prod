FROM owasp/modsecurity-crs:nginx

USER root

RUN apt-get update \
    && apt-get install -y --no-install-recommends curl \
    && apt-get clean \
    && rm -rf /var/lib/apt/lists/*

# Prod config: internal HTTP gateway behind external TLS terminator.
COPY default.prod.conf /etc/nginx/templates/conf.d/default.conf.template

EXPOSE 8080
